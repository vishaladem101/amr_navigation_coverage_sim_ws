<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="width" default="0.6"/>
    <xacro:arg name="wheel_radius" default="0.1"/>
    <xacro:arg name="wheel_width" default="0.05"/>

    <xacro:property name="length" value="0.8"/>
    <xacro:property name="width" value="$(arg width)"/>
    <xacro:property name="height" value="0.4"/>

    <xacro:property name="mass" value="15.0"/>
    <xacro:property name="wheel_mass" value="1.0"/>
    <xacro:property name="caster_wheel_radius" value="0.05"/>

    <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
    <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
    <xacro:property name="wheel_separation" value="${width + wheel_width}"/>


    <!-- BASE -->
    <link name="base_link">
        <visual>
            <geometry>
                <box size="${length} ${width} ${height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${height/2}" rpy="0 0 0"/>
            <material name="blue"/>
        </visual>

        <xacro:box_inertia m="${mass}" x="${length}" y="${width}" z="${height}" o_xyz="0 0 ${height/2}" o_rpy="0 0 0"/>

        <collision>
            <geometry>
                <box size="${length} ${width} ${height}"/>
            </geometry>
            <origin xyz="0.0 0.0 ${height/2}" rpy="0 0 0"/>
        </collision>
    </link>

    <!-- LEFT WHEEL -->
    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>

            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
            <material name="grey"/>
        </visual>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>

        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        </collision>
    </link>

    
    <!-- RIGHT WHEEL -->
    <link name="right_wheel">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

            <material name="grey"/>
        </visual>

        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>

        <collision>
            <geometry>
                <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        </collision>
    </link>
    
    <!-- CASTER WHEEL -->
    <link name="caster_link">
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <xacro:sphere_inertia m="1.0" r="${caster_wheel_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>

        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
    </link>

    <link name="base_footprint"/>

    

    <!-- Joints -->
    <!-- Base Joint -->
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- LEFT WHEEL JOINT -->
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-(length/4)} ${wheel_separation/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- RIGHT WHEEL JOINT -->
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-(length/4)} ${-wheel_separation/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- CASTER Wheel -->
    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_link"/>
        <origin xyz="${(length/2)-caster_wheel_radius} 0 -${wheel_radius-caster_wheel_radius}" rpy="0 0 0"/>
    </joint>

</robot>